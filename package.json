{
  "name": "glightbox-monorepo",
  "private": true,
  "workspaces": [
    "packages/glightbox",
    "packages/docs",
    "packages/build"
  ],
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:docs",
    "build:lib": "npm run build --workspace @tomasvn/glightbox",
    "build:docs": "npm run build --workspace @tomasvn/glightbox-docs",
    "dev:docs": "npm run dev --workspace @tomasvn/glightbox-docs",
    "preview:docs": "npm run preview --workspace @tomasvn/glightbox-docs",
    "test": "npm test --workspace @tomasvn/glightbox",
    "test:types": "npm run test:types --workspace @tomasvn/glightbox",
    "watch": "npm run watch --workspace @tomasvn/glightbox",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "lint": "npm run lint --workspace @tomasvn/glightbox",
    "format": "npm run format --workspace @tomasvn/glightbox",
    "prepare": "husky",
    "deploy": "npm publish --workspace @tomasvn/glightbox"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,md,mdx,html,css,scss,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "license": "MIT",
  "homepage": "https://tomasvn.github.io/glightbox/",
  "repository": {
    "url": "https://github.com/tomasvn/glightbox",
    "type": "git"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  }
}
