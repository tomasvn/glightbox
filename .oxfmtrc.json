{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "none",
  "tabWidth": 4,
  "printWidth": 220,
  "proseWrap": "never",
  "semi": true,
  "singleQuote": true,
  "arrowParens": "always",
  "htmlWhitespaceSensitivity": "ignore",
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.json"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.md"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.yml"],
      "options": {
        "tabWidth": 2
      }
    }
  ],
  "ignorePatterns": ["node_modules", "**/dist/**", "**/.astro/**", "packages/docs/public/**"]
}
